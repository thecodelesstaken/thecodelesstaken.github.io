{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ printf "%s — Writing" site.Title | transform.XMLEscape | safeHTML }}</title>
    <link>{{ "writing/" | absURL }}</link>
    <description>{{ "New investigations and field notes on uncommon languages, forgotten systems, and alternative computing." | transform.XMLEscape | safeHTML }}</description>
    <language>en-US</language>
    <copyright>{{ printf "© %d %s" now.Year site.Title | transform.XMLEscape | safeHTML }}</copyright>
    {{- with .OutputFormats.Get "RSS" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- $pages := where site.RegularPages "Section" "writing" }}
    {{- range first 20 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      <content:encoded>{{ .Content | transform.XMLEscape | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
